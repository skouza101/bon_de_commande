# ===========================================================================
# Configuration Exemple — Facturation & Numérisation Pneus IA
# ===========================================================================

# Fournisseur IA Actif: 'gemini' (recommandé avec secours OpenRouter) ou 'deepseek'
AI_PROVIDER=gemini

# Configuration Google Gemini (Moteur Principal)
# Obtenez une clé gratuite sur https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Configuration OpenRouter (Secours Automatique)
# Obtenez une clé sur https://openrouter.ai/keys
DEEPSEEK_API_KEY=sk-or-v1-your-openrouter-key-here
DEEPSEEK_MODEL=google/gemini-3.1-flash-lite-image
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1

# Informations Entreprise & En-tête de Facture
COMPANY_NAME=Tous Pneus
COMPANY_ADDRESS=189 LOT ANOUAR SIDI BENNOUR MAROC
COMPANY_PHONE=+212600000000
COMPANY_EMAIL=contact@touspneus.ma
CURRENCY=MAD

# Serveur Web FastAPI
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Base de Données & Répertoires
DB_PATH=./invoices.db
TEMP_DIR=./temp_downloads
OUTPUT_DIR=./output_invoices